<view class="page">
  <view class="hero">
    <text class="title">Mini Scan</text>
    <text class="subtitle">拍一张，自动拉正为扫描件</text>
  </view>

  <view class="preview" bindtap="chooseImage">
    <image wx:if="{{resultPath || sourcePath}}" src="{{resultPath || sourcePath}}" mode="aspectFit" />
    <view wx:else class="empty">
      <text class="camera">▣</text>
      <text>点击拍照或选择图片</text>
    </view>
  </view>

  <view class="modes">
    <view class="mode {{mode === 'color' ? 'active' : ''}}" data-mode="color" bindtap="setMode">彩色扫描</view>
    <view class="mode {{mode === 'bw' ? 'active' : ''}}" data-mode="bw" bindtap="setMode">黑白扫描</view>
  </view>

  <button class="primary" bindtap="{{sourcePath ? 'scan' : 'chooseImage'}}" loading="{{loading}}">
    {{sourcePath ? (loading ? '正在扫描…' : '自动扫描') : '拍照 / 选图'}}
  </button>

  <button wx:if="{{sourcePath}}" class="secondary" bindtap="chooseImage">重新拍摄</button>
</view>
