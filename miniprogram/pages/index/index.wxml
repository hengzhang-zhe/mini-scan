<view class="page">
  <view class="hero">
    <text class="title">Mini Scan</text>
    <text class="subtitle">简单扫描本地完成，不满意再智能优化</text>
  </view>

  <view class="preview" bindtap="chooseImage">
    <image
      wx:if="{{resultPath || sourcePath}}"
      src="{{resultPath || sourcePath}}"
      mode="aspectFit"
      style="transform: rotate({{rotationAngle}}deg);"
    />
    <view wx:else class="empty">
      <text class="camera">▣</text>
      <text>点击拍照或选择图片</text>
    </view>
  </view>

  <view wx:if="{{sourcePath && scanMode === 'quick'}}" class="rotate-panel">
    <view class="rotate-head">
      <text class="section-title rotate-title">旋转</text>
      <text class="angle-value">{{rotationAngle}}°</text>
    </view>

    <view
      class="dial"
      bindtouchstart="onDialStart"
      catchtouchmove="onDialMove"
      bindtouchend="onDialEnd"
      bindtouchcancel="onDialEnd"
    >
      <view class="dial-pointer"></view>
      <view class="dial-track" style="transform: translateX(calc(-50% + {{dialOffset}}rpx));">
        <view
          wx:for="{{rotationTicks}}"
          wx:key="angle"
          class="dial-tick-wrap"
        >
          <view class="dial-tick {{item.major ? 'major' : ''}}"></view>
          <text wx:if="{{item.major}}" class="dial-label">{{item.angle}}</text>
        </view>
      </view>
    </view>

    <view class="rotate-actions">
      <button class="mini-action" bindtap="resetRotation" disabled="{{loading}}">归零</button>
      <button class="mini-action" bindtap="rotate90" disabled="{{loading}}">+90°</button>
    </view>
  </view>

  <view class="section-title">处理方式</view>
  <view class="scan-modes">
    <view class="scan-card {{scanMode === 'quick' ? 'active' : ''}}" data-mode="quick" bindtap="setScanMode">
      <text class="scan-name">快速扫描</text>
      <text class="scan-desc">本地处理 · 更快 · 无需上传</text>
    </view>
    <view class="scan-card {{scanMode === 'smart' ? 'active' : ''}}" data-mode="smart" bindtap="setScanMode">
      <text class="scan-name">智能优化</text>
      <text class="scan-desc">复杂图片 · 效果优先</text>
    </view>
  </view>

  <view class="section-title">输出效果</view>
  <view class="modes">
    <view class="mode {{filterMode === 'color' ? 'active' : ''}}" data-mode="color" bindtap="setFilterMode">彩色</view>
    <view class="mode {{filterMode === 'bw' ? 'active' : ''}}" data-mode="bw" bindtap="setFilterMode">黑白</view>
  </view>

  <button class="primary" bindtap="handlePrimary" loading="{{loading}}">
    {{!sourcePath ? '拍照 / 选图' : (scanMode === 'quick' ? (loading ? '正在快速扫描…' : '快速扫描') : (loading ? '正在智能优化…' : '智能优化'))}}
  </button>

  <button wx:if="{{sourcePath}}" class="secondary" bindtap="chooseImage" disabled="{{loading}}">重新拍摄</button>

  <canvas
    class="quick-canvas"
    canvas-id="quickCanvas"
    style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
  ></canvas>
</view>
